---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getDictionary, getLocale } from '../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dictionary = getDictionary(getLocale(Astro.currentLocale));
---
<Base title={`${post.data.title} | ${dictionary.siteTitle}`}>
  <Header />
  <main class="content-page content-detail">
    <article class="container content-narrow">
      <a class="back-link" href={Astro.currentLocale === 'en' ? '/en/blog/' : '/blog/'}>{dictionary.blogPage.back}</a>
      <p class="content-date">{post.data.pubDate.toLocaleDateString('es-AR')}</p>
      <h1 class="section-title">{post.data.title}</h1>
      <p class="content-intro">{post.data.description}</p>
      {post.data.tags && <div class="content-tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>}
      <div class="markdown-content"><Content /></div>
    </article>
  </main>
</Base>

---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import { getDictionary } from '../../../i18n/utils';

export async function getStaticPaths() {
  const projects = await getCollection('proyectos');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const dictionary = getDictionary(Astro.currentLocale);
---
<Base title={`${project.data.title} | ${dictionary.siteTitle}`}>
  <Header />
  <main class="content-page content-detail">
    <article class="container content-narrow">
      <a class="back-link" href="/en/proyectos/">{dictionary.projectsPage.back}</a>
      <p class="content-date">{project.data.categoria}</p>
      <h1 class="section-title">{project.data.title}</h1>
      <p class="project-location project-location-detail">{project.data.ubicacion}</p>
      <img class="project-cover" src={project.data.coverImage} alt={project.data.title}>
      <p class="content-intro">{project.data.description}</p>
      <div class="markdown-content"><Content /></div>
      {project.data.gallery && project.data.gallery.length > 0 && <div class="project-gallery">{project.data.gallery.map((image) => <img src={image} alt={project.data.title} loading="lazy">)}</div>}
    </article>
  </main>
</Base>

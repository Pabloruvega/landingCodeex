---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import { getDictionary, getLocale, localizedUrl } from '../../../i18n/utils';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const locale = getLocale(Astro.currentLocale);
const dictionary = getDictionary(locale);
---
<Base title={`${dictionary.blogPage.title} | ${dictionary.siteTitle}`}>
  <Header />
  <main class="content-page">
    <div class="container">
      <div class="eyebrow">{dictionary.blogPage.eyebrow}</div>
      <h1 class="section-title">{dictionary.blogPage.title}</h1>
      <p class="content-intro">{dictionary.blogPage.intro}</p>
      <div class="content-grid">
        {posts.map((post) => (
          <article class="content-card">
            <div class="content-card-body">
              <p class="content-date">{post.data.pubDate.toLocaleDateString('en-US')}</p>
              <h2><a href={localizedUrl(locale, `blog/${post.id}`)}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              {post.data.tags && <div class="content-tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>}
              <a class="text-link" href={localizedUrl(locale, `blog/${post.id}`)}>{dictionary.blogPage.read}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</Base>

---
import { getDictionary, getLocale, switchLocaleUrl } from '../i18n/utils';
import backdrop from '../assets/hero.webp';
import logoChico from '../assets/Logo-chico.webp';

const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale).cinema;
const otherLocale = locale === 'es' ? 'en' : 'es';
---

<section class="cinema-scroll" id="cinema" aria-label={t.scrollAria}>
  <div class="stage">
    <div class="world">
      <img class="scene-img sky-img" src={backdrop.src} alt="" />
      <div class="shade"></div>

      <header class="site-header" aria-label={t.navAria}>
        <a class="site-logo" href="#cinema" aria-label={t.logo}>
          <img src={logoChico.src} alt={t.logo} />
        </a>
        <nav class="site-nav" aria-label={t.menuAria}>
          <a href="#cinema">{t.navIntro}</a>
          <a href="#servicios">{t.navServices}</a>
          <a href="#proyectos">{t.navProjects}</a>
          <a href="#contacto">{t.navContact}</a>
        </nav>
        <a
          class="language-switcher"
          href={switchLocaleUrl(otherLocale, Astro.url.pathname)}
          aria-label={t.langAria}
        >
          <span>{otherLocale.toUpperCase()}</span>
          <span aria-hidden="true">⌄</span>
        </a>
      </header>

      <div class="back-stack">
        <section class="sights-slider" aria-label={t.sliderAria}>
          <div class="sights-track">
            {t.cards.map((card) => (
              <article class="sight-card" tabindex="0" role="button" aria-label={card.aria}>
                <span class="sight-kicker">{card.kicker}</span>
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </article>
            ))}
          </div>
        </section>
      </div>

      <div class="sights-controls" aria-label={t.controlsAria}>
        <button class="sight-nav sight-prev" type="button" aria-label={t.prevAria}>←</button>
        <button class="sight-nav sight-next" type="button" aria-label={t.nextAria}>→</button>
      </div>

      <h1 class="hero-title">{t.heroTitle}</h1>
    </div>

    <section class="intro-copy" aria-label={t.introAria}>
      <p>{t.introText}</p>
      <div class="hero-tags" aria-label={t.tagsAria}>
        {t.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </section>

    <section class="story-panel story-panel-bridge" aria-label={t.bridgeAria}>
      <h2>{t.bridgeTitle}</h2>
      <p>{t.bridgeText}</p>
      <dl class="facts">
        {t.bridgeFacts.map((fact) => (
          <div><dt>{fact.dt}</dt><dd>{fact.dd}</dd></div>
        ))}
      </dl>
    </section>

    <section class="story-panel story-panel-bazaar" aria-label={t.bazaarAria}>
      <h2>{t.bazaarTitle}</h2>
      <p>{t.bazaarText}</p>
      <a class="note-button" href="#servicios">
        <span aria-hidden="true">↗</span>
        <span>{t.bazaarNote}</span>
      </a>
    </section>
  </div>
</section>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&display=swap");

  :root {
    --mx: 0; --my: 0;
    --bg-x: 0px; --bg-y: 0px; --bg-scale: 1.06; --bg-blur: 0px; --bg-bright: 0.5;
    --back-scale: 0.78;
    --title-y: 0px; --title-scale: 1; --title-opacity: 1;
    --intro-copy-y: 0px; --intro-copy-opacity: 1;
    --panel2-opacity: 0; --panel2-y: calc(-50% + 58px);
    --panel3-opacity: 0; --panel3-y: calc(-50% + 58px);
    --sights-controls-opacity: 0; --sights-y: 0px;
    --sights-enter-x: 420vw; --sights-visibility: hidden;
    --sights-shift: 0px; --sights-scale: 1;
    --sights-top: clamp(112px, 19vh, 220px);
    --sights-screen-top: clamp(112px, 19vh, 220px);
    --ink: #111411; --paper: #fdf1e1;
    --cinema-dark: #12161a; --cinema-shadow: rgba(0, 0, 0, 0.45);
  }

  body { overflow-x: clip; }

  .cinema-scroll * { box-sizing: border-box; }
  .cinema-scroll button { border: 0; font: inherit; }

  .cinema-scroll {
    position: relative;
    height: calc(100vh + 3700px);
    padding: 0;
    color: var(--paper);
    background: var(--cinema-dark);
    font-family: Inter, Satoshi, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }
  .cinema-scroll section { padding: 0; }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 620px;
    overflow: hidden;
    isolation: isolate;
    background: var(--cinema-dark);
  }

  .world, .back-stack, .sky-img, .shade,
  .site-header, .sights-slider, .sights-controls,
  .hero-title, .intro-copy, .story-panel {
    position: absolute;
  }

  .world { inset: 0; overflow: hidden; background: var(--cinema-dark); }

  .scene-img {
    display: block;
    max-width: none;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .sky-img {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    filter: brightness(var(--bg-bright)) saturate(0.9);
    transform: translate3d(var(--bg-x), var(--bg-y), 0) scale(var(--bg-scale));
    transform-origin: 50% 50%;
  }

  .shade {
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(180deg,
      rgba(8, 11, 14, 0.34) 0%,
      rgba(8, 11, 14, 0.30) 40%,
      rgba(8, 11, 14, 0.88) 100%);
  }

  .site-header {
    top: 0; left: 0; right: 0; z-index: 10;
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto minmax(220px, 1fr);
    align-items: center;
    gap: 32px;
    padding: 32px;
    color: rgba(253, 241, 225, 0.9);
    pointer-events: auto;
  }
  .site-logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    line-height: 1;
    text-decoration: none;
  }
  .site-logo img { display: block; width: auto; height: 24px; filter: brightness(0) invert(1); }
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 2.2vw, 44px);
  }
  .site-nav a, .language-switcher {
    color: rgba(253, 241, 225, 0.92);
    font-weight: 500;
    line-height: 1;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
  }
  .site-nav a { font-size: 15px; letter-spacing: 0.03em; text-decoration: none; }
  .site-nav a:hover { color: #fff; }
  .language-switcher {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0;
    background: transparent;
    font-size: 14px;
    letter-spacing: 0.04em;
    cursor: pointer;
    text-decoration: none;
  }
  .language-switcher span { display: inline-flex; line-height: 1; }

  .back-stack {
    inset: 0;
    transform: scale(var(--back-scale));
    transform-origin: 50% 100%;
  }

  .sights-slider {
    left: 0; right: 0;
    top: var(--sights-top);
    z-index: 2;
    visibility: var(--sights-visibility);
    transform: translate3d(var(--sights-enter-x), var(--sights-y), 0) scale(var(--sights-scale));
    transform-origin: 0 0;
    pointer-events: auto;
  }
  .sights-track {
    display: flex;
    gap: clamp(16px, 1.15vw, 24px);
    align-items: stretch;
    padding-left: 6vw;
    transform: translate3d(calc(var(--sights-shift) - 6vw), 0, 0);
    transition: transform 640ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sights-track.is-jumping { transition: none; }

  .sight-card {
    position: relative;
    flex: 0 0 clamp(300px, 22vw, 380px);
    height: 210px;
    padding: 24px;
    overflow: hidden;
    border-radius: 22px;
    color: #000;
    background: #fdf1e1;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .sight-card:hover { transform: translateY(-4px); box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5); }
  .sight-card:focus-visible { outline: 2px solid var(--paper); outline-offset: 3px; }
  .sight-kicker {
    display: block;
    margin-bottom: 12px;
    color: var(--ink);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .sight-card h3 {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: calc(24px + (15px * 1.2 * 2) + 12px);
    margin: 0;
    color: #000;
    font-family: "Fraunces", Georgia, serif;
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sight-card p {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    margin: 0;
    color: #2a2f35;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .sights-controls {
    left: 32px;
    top: calc(var(--sights-screen-top) + 210px + 20px);
    z-index: 5;
    display: flex;
    gap: 14px;
    opacity: var(--sights-controls-opacity);
    transform: translate3d(0, var(--sights-y), 0);
    pointer-events: none;
  }
  .sights-controls.is-ready { pointer-events: auto; }
  .sight-nav {
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: var(--ink);
    background: rgba(253, 241, 225, 0.94);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    font-size: 18px;
  }
  .sight-nav:hover { background: #fff; }

  .hero-title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .intro-copy {
    left: 50%;
    bottom: clamp(72px, 26vh, 360px);
    z-index: 9;
    width: min(620px, calc(100vw - 40px));
    text-align: center;
    transform: translate3d(-50%, var(--intro-copy-y), 0);
    opacity: var(--intro-copy-opacity);
  }
  .intro-copy p {
    margin: 0 auto;
    max-width: 620px;
    color: var(--paper);
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.5;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.6);
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
  .hero-tags span {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
    color: var(--paper);
    border: 1px solid rgba(253, 241, 225, 0.28);
    border-radius: 999px;
    background: rgba(253, 241, 225, 0.06);

    font-size: 0.95rem;
    font-weight: 500;
  }

  .story-panel {
    left: 50%;
    top: 50%;
    z-index: 10;
    width: min(760px, calc(100vw - 42px));
    text-align: center;
    pointer-events: none;
    transform: translate3d(-50%, -50%, 0);
  }
  .story-panel h2 {
    margin: 0;
    color: var(--paper);
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(2.4rem, 6vw, 4.75rem);
    font-weight: 500;
    line-height: 1.02;
    text-shadow: 0 18px 44px var(--cinema-shadow);
  }
  .story-panel p {
    width: min(540px, 100%);
    margin: 24px auto 0;
    color: rgba(253, 241, 225, 0.92);
    font-size: 1.12rem;
    font-weight: 400;
    line-height: 1.45;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
  }
  .story-panel-bridge {
    opacity: var(--panel2-opacity);
    transform: translate3d(-50%, var(--panel2-y), 0);
  }
  .story-panel-bazaar {
    opacity: var(--panel3-opacity);
    transform: translate3d(-50%, var(--panel3-y), 0);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    width: min(480px, 100%);
    margin: 52px auto 0;
  }
  .facts dt {
    color: var(--paper);
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 500;
    line-height: 0.92;
    text-shadow: 0 14px 34px var(--cinema-shadow);
  }
  .facts dd {
    margin: 14px 0 0;
    color: rgba(253, 241, 225, 0.82);
    font-size: 0.98rem;
    font-weight: 400;
    line-height: 1.25;
  }
  .note-button {
    min-height: 50px;
    margin-top: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 28px;
    border-radius: 999px;
    color: var(--ink);
    background: var(--paper);
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.35);
    pointer-events: auto;
    cursor: pointer;
    font-weight: 600;
    text-decoration: none;
  }
  .note-button span:first-child { font-size: 1.2rem; line-height: 1; }

  @media (max-width: 900px) {
    .site-header { grid-template-columns: 1fr auto; gap: 16px; padding: 22px 20px; }
    .site-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      gap: 18px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .site-nav::-webkit-scrollbar { display: none; }
    .intro-copy { bottom: clamp(60px, 16vh, 180px); }
    .intro-copy p { font-size: 1.05rem; }
    .story-panel p { font-size: 1rem; }
    .facts { gap: 24px; margin-top: 36px; }
    .sights-controls { left: 20px; top: calc(var(--sights-screen-top) + 226px); }
    .sight-card { flex-basis: min(78vw, 320px); }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .scene-img, .hero-title, .intro-copy, .story-panel,
    .sights-track, .sights-slider { transition: none; }
  }
</style>

<script>
  const REDUCE = window.matchMedia("(prefers-reduced-motion: reduce)");
  const root = document.documentElement;

  let section: HTMLElement | null = null;
  let track: HTMLElement | null = null;
  let controls: HTMLElement | null = null;
  let prevBtn: HTMLElement | null = null;
  let nextBtn: HTMLElement | null = null;
  let baseCards: HTMLElement[] = [];

  let targetMouseX = 0, targetMouseY = 0;
  let mouseX = 0, mouseY = 0;
  let targetScroll = 0, smoothScroll = 0;
  let initialized = false;
  let rafPending = false;
  let sectionTop = 0;
  let sectionHeight = 0;
  let viewportH = 0;
  let sightCards: HTMLElement[] = [];
  let originalSightCount = 0;
  let activeSight = 0;
  let listenersBound = false;

  const clamp = (v: number, min = 0, max = 1) => Math.min(max, Math.max(min, v));
  const smoothstep = (e0: number, e1: number, v: number) => {
    const x = clamp((v - e0) / (e1 - e0));
    return x * x * (3 - 2 * x);
  };
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const segmentInOut = (s: number, a: number, b: number, c: number, d: number) => {
    const enter = smoothstep(a, b, s);
    const exit = smoothstep(c, d, s);
    return { enter, exit, active: enter * (1 - exit) };
  };
  // Measure layout once (and on resize) so the per-frame loop never forces a
  // synchronous reflow — reading scrollY does not, reading getBoundingClientRect
  // every frame does and thrashes layout on a long page.
  function measure() {
    if (!section) return;
    const rect = section.getBoundingClientRect();
    sectionTop = rect.top + window.scrollY;
    sectionHeight = section.offsetHeight;
    viewportH = window.innerHeight;
  }

  const setVar = (name: string, value: string | number) =>
    root.style.setProperty(name, String(value));

  function update() {
    rafPending = false;
    if (!section || !section.isConnected) return;

    const scrollY = window.scrollY;

    // Idle while the cinematic section is fully off-screen.
    if (scrollY >= sectionTop + sectionHeight || scrollY + viewportH <= sectionTop) {
      return;
    }

    targetScroll = clamp(scrollY - sectionTop, 0, sectionHeight - viewportH);
    if (!initialized || REDUCE.matches) {
      smoothScroll = targetScroll;
      initialized = true;
    } else {
      smoothScroll = lerp(smoothScroll, targetScroll, 0.14);
    }
    if (Math.abs(smoothScroll - targetScroll) < 0.08) smoothScroll = targetScroll;

    mouseX = lerp(mouseX, targetMouseX, 0.12);
    mouseY = lerp(mouseY, targetMouseY, 0.12);

    const frame2 = segmentInOut(smoothScroll, 560, 900, 1300, 1620);
    const frame3 = segmentInOut(smoothScroll, 1760, 2140, 2540, 2700);
    const progress = clamp(smoothScroll / 2700);
    const introExit = smoothstep(90, 650, smoothScroll);
    const sightsEnterRaw = smoothstep(2760, 3560, smoothScroll);
    const sightsEnter = Math.pow(sightsEnterRaw, 1.55);
    const sightsControlsEnter = smoothstep(3360, 3660, smoothScroll);
    const focusActive = clamp(frame2.active + frame3.active);
    const panel2Opacity = frame2.active * (1 - frame2.exit);
    const panel3Opacity = frame3.active * (1 - frame3.exit);
    const backScale = 0.78 + progress * 0.16 + sightsEnter * 0.06;
    const sightsScreenTop = Math.min(220, Math.max(112, viewportH * 0.19)) - 18;
    const sightsParentTop = viewportH - (viewportH - sightsScreenTop) / backScale;

    setVar("--mx", REDUCE.matches ? 0 : mouseX.toFixed(4));
    setVar("--my", REDUCE.matches ? 0 : mouseY.toFixed(4));

    setVar("--bg-x", `${mouseX * -14}px`);
    setVar("--bg-y", `${mouseY * -8}px`);
    setVar("--bg-scale", 1.06 + progress * 0.14);
    setVar("--bg-blur", `${focusActive * 10}px`);
    setVar("--bg-bright", 0.86 - focusActive * 0.36 - introExit * 0.06);
    setVar("--back-scale", backScale);

    setVar("--intro-copy-y", `${introExit * 80}px`);
    setVar("--intro-copy-opacity", 1 - introExit);

    setVar("--panel2-opacity", panel2Opacity);
    setVar("--panel2-y", `calc(-50% + ${-frame2.exit * 80 + (1 - frame2.enter) * 58}px)`);
    setVar("--panel3-opacity", panel3Opacity);
    setVar("--panel3-y", `calc(-50% + ${-frame3.exit * 80 + (1 - frame3.enter) * 58}px)`);

    setVar("--sights-controls-opacity", sightsControlsEnter);
    if (controls) controls.classList.toggle("is-ready", sightsControlsEnter > 0.98);
    setVar("--sights-visibility", sightsEnter > 0.01 ? "visible" : "hidden");
    setVar("--sights-y", "0px");
    setVar("--sights-enter-x", `${(1 - sightsEnter) * 420}vw`);
    setVar("--sights-scale", 1 / backScale);
    setVar("--sights-top", `${sightsParentTop}px`);
    setVar("--sights-screen-top", `${sightsScreenTop}px`);

    if (
      Math.abs(smoothScroll - targetScroll) > 0.08 ||
      Math.abs(mouseX - targetMouseX) > 0.001 ||
      Math.abs(mouseY - targetMouseY) > 0.001
    ) {
      requestTick();
    }
  }

  function requestTick() {
    if (rafPending) return;
    rafPending = true;
    requestAnimationFrame(update);
  }

  function updateSightSlider() {
    if (!track || !sightCards.length) return;
    const cardWidth = sightCards[0].offsetWidth;
    const gap = parseFloat(getComputedStyle(track).columnGap || "0");
    setVar("--sights-shift", `${-(cardWidth + gap) * activeSight}px`);
    sightCards.forEach((card) => {
      card.classList.toggle("is-active", Number(card.dataset.sightIndex) === activeSight);
    });
  }

  function moveSightSlider(dir: number) {
    activeSight += dir;
    updateSightSlider();
  }

  function selectSightCard(card: HTMLElement) {
    const idx = Number(card.dataset.sightIndex);
    if (Number.isFinite(idx)) activeSight = idx;
    updateSightSlider();
  }

  function jumpSightSlider(i: number) {
    if (!track) return;
    track.classList.add("is-jumping");
    activeSight = i;
    updateSightSlider();
    requestAnimationFrame(() =>
      requestAnimationFrame(() => track && track.classList.remove("is-jumping"))
    );
  }

  function normalizeSightSlider() {
    if (activeSight >= originalSightCount * 2) {
      jumpSightSlider(activeSight - originalSightCount);
    } else if (activeSight < originalSightCount) {
      jumpSightSlider(activeSight + originalSightCount);
    }
  }

  function setupSightSlider() {
    if (!track) return;
    const originals = baseCards;
    originalSightCount = originals.length;
    if (!originalSightCount) return;

    track.replaceChildren();
    for (let setIndex = 0; setIndex < 3; setIndex++) {
      originals.forEach((card, cardIndex) => {
        const clone = card.cloneNode(true) as HTMLElement;
        clone.dataset.sightIndex = String(setIndex * originalSightCount + cardIndex);
        track!.appendChild(clone);
      });
    }
    sightCards = Array.from(track.querySelectorAll<HTMLElement>(".sight-card"));
    activeSight = originalSightCount;

    sightCards.forEach((card) => {
      card.addEventListener("click", () => selectSightCard(card));
      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selectSightCard(card);
        }
      });
    });
    track.addEventListener("transitionend", normalizeSightSlider);
    updateSightSlider();
  }

  function init() {
    section = document.querySelector<HTMLElement>(".cinema-scroll");
    if (!section) return;

    track = document.querySelector<HTMLElement>(".sights-track");
    controls = document.querySelector<HTMLElement>(".sights-controls");
    prevBtn = document.querySelector<HTMLElement>(".sight-prev");
    nextBtn = document.querySelector<HTMLElement>(".sight-next");
    baseCards = Array.from(
      document.querySelectorAll<HTMLElement>(".sights-track > .sight-card")
    );

    initialized = false;
    measure();

    if (prevBtn) prevBtn.addEventListener("click", () => moveSightSlider(-1));
    if (nextBtn) nextBtn.addEventListener("click", () => moveSightSlider(1));

    if (!listenersBound) {
      listenersBound = true;
      window.addEventListener("scroll", requestTick, { passive: true });
      window.addEventListener("load", () => { measure(); requestTick(); });
      window.addEventListener("resize", () => {
        measure();
        updateSightSlider();
        requestTick();
      });
      window.addEventListener(
        "pointermove",
        (event) => {
          targetMouseX = event.clientX / window.innerWidth - 0.5;
          targetMouseY = event.clientY / window.innerHeight - 0.5;
          requestTick();
        },
        { passive: true }
      );
    }

    setupSightSlider();
    requestTick();
  }

  document.addEventListener("astro:page-load", init);
</script>

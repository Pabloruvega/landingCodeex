---
import { getDictionary, getLocale } from '../i18n/utils';
const dictionary = getDictionary(getLocale(Astro.currentLocale));
---
<section id="proyectos" style="padding-bottom:0; background:var(--cream);" data-reveal>
  <div class="container" style="padding-bottom:60px;"><div class="eyebrow">{dictionary.projectsHome.eyebrow}</div><h2 class="section-title">{dictionary.projectsHome.intro}</h2></div>
  <div class="galeria-strip">
    <img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/12.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/13.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/14-2.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/15-2.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/16-2.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/17-2.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/18-2.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/19-2.webp" alt="">
  </div>
</section>
<article class="proyecto-feature" id="proyecto-coral" data-reveal><div class="pf-grid"><div class="pf-img"><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/10-1-1024x407.webp" alt="Complejo Coral"></div><div class="pf-content"><span class="tag">Complejo Coral</span><h3>{dictionary.projectsHome.coralTitle}</h3><p>{dictionary.projectsHome.coralDescription}</p><div class="pf-location">{dictionary.projectsHome.coralLocation}</div><a class="btn" href="https://complejocoral.com.ar/" target="_blank" rel="noopener">{dictionary.projectsHome.more}</a></div></div></article>
<article class="proyecto-feature" id="proyecto-umbra" data-reveal><div class="pf-grid"><div class="pf-content" style="order:2;"><span class="tag">Umbra del Bono Residence</span><h3>{dictionary.projectsHome.umbraTitle}</h3><p>{dictionary.projectsHome.umbraDescription}</p><div class="pf-location">{dictionary.projectsHome.umbraLocation}</div><a class="btn" href="https://umbra.website/" target="_blank" rel="noopener">{dictionary.projectsHome.more}</a></div><div class="pf-img" style="order:1;"><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/11-1-1024x407.webp" alt="Umbra del Bono"></div></div></article>
<div class="galeria-strip" style="margin-bottom:0;"><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/12-2.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/13-2.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/14-1.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/15-1.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/16-1.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/17-1.webp" alt=""><img src="https://codeexconstrucciones.com.ar/wp-content/uploads/2026/06/18-1.webp" alt=""></div>